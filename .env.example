# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Apify — https://console.apify.com/account/integrations
APIFY_TOKEN=

# Pixabay (video stock miễn phí) — https://pixabay.com/api/docs/ (đăng nhập để thấy key)
PIXABAY_API_KEY=

# Gemini API (video AI Gemini Omni Flash) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram: tạo bot qua @BotFather; lấy chat id bằng cách gửi /chatid cho bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok for Developers — https://developers.tiktok.com (app có Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/tiktok/callback
