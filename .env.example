# ======================= BẮT BUỘC =======================
# Telegram: tạo bot qua @BotFather → dán token
TELEGRAM_BOT_TOKEN=
# Để trống lúc đầu; gửi /start cho bot, bot sẽ trả lời Chat ID của bạn
TELEGRAM_CHAT_ID=
# Claude (Anthropic) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ======================= NÊN CÓ (miễn phí) =======================
# Apify (quét kênh đối thủ, gói Free ~5 USD/tháng) — https://console.apify.com/account/integrations
APIFY_TOKEN=
# Pixabay (video stock dự phòng khi thiếu clip) — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ======================= ĐĂNG TIKTOK =======================
# TikTok for Developers — https://developers.tiktok.com (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ======================= TUỲ CHỌN (TRẢ PHÍ) =======================
# Gemini API để tạo clip AI tự động thay vì tạo tay trên Google Flow. Mỗi lần dùng đều phải duyệt ngân sách.
GEMINI_API_KEY=
# Lưu kịch bản đã duyệt lên Google Drive (OAuth client loại "TVs and Limited Input devices"), rồi gõ /drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======================= TỰ ĐỘNG ĐIỀN (không cần sửa) =======================
# deploy/install.sh tự tạo các giá trị dưới đây
DOMAIN=
WORKER_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
