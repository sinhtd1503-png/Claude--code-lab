      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_URL }}/{{ $json.route }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Token",
              "value": "={{ $env.WORKER_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || {}) }}",
        "options": {
