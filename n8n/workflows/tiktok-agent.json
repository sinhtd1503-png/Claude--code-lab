    {
      "id": "31f6d0a5-8565-54ca-aac6-6f38c14935bb",
      "name": "Gọi worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_URL }}/{{ $json.route }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Token",
              "value": "={{ $env.WORKER_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || {}) }}",
        "options": {
          "timeout": 1800000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "cdf4ff87-98ab-521b-9452-27b3a1022183",
      "name": "Đọc kết quả",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "jsCode": "// Worker luôn trả {messages: [...], next: {...}}. Nếu worker lỗi/không chạy → báo lỗi lên Telegram.\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (Array.isArray(j.messages)) { out.push({ json: { messages: j.messages, next: j.next || null } }); continue; }\n  const err = j.error?.message || j.detail || JSON.stringify(j).slice(0, 300);\n  out.push({ json: { next: null, messages: [{ method: 'sendMessage', payload: {\n    chat_id: $env.TELEGRAM_CHAT_ID, text: '⚠️ n8n không gọi được worker: ' + err } }] } });\n}\nreturn out;"
      }
    },
    {
      "id": "0194899a-b514-5eea-8bfc-961863f99881",
      "name": "Tách tin nhắn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) for (const m of it.json.messages || []) out.push({ json: m });\nreturn out;"
      }
    },
