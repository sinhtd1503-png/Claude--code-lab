    {
      "id": "676cf67f-df65-516a-9bb4-a9c07dfeb1f8",
      "name": "Phân loại tin nhắn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Đổi tin nhắn Telegram thành 1 yêu cầu cho worker: lệnh (/...), bấm nút, góp ý (chữ), clip video, nhạc nền, ảnh.\nconst u = $json.body || {};\nconst secret = ($json.headers || {})['x-telegram-bot-api-secret-token'] || '';\nlet route = null;\nconst body = { secret };\nif (u.callback_query) {\n  const c = u.callback_query;\n  route = 'tg/button';\n  Object.assign(body, { chat_id: c.message?.chat?.id, data: c.data, message_id: c.message?.message_id, callback_id: c.id });\n} else if (u.message) {\n  const m = u.message;\n  Object.assign(body, {\n    chat_id: m.chat.id, message_id: m.message_id,\n    reply_to_text: m.reply_to_message?.text || m.reply_to_message?.caption || '',\n  });\n  const doc = m.document && (m.document.mime_type || '').startsWith('video/') ? m.document : null;\n  const vid = m.video || m.animation || doc;\n  if (vid) {\n    route = 'tg/clip';\n    Object.assign(body, { file_id: vid.file_id, file_size: vid.file_size || 0, caption: m.caption || '', media_group_id: m.media_group_id || '' });\n  } else if (m.audio || (m.document && ((m.document.mime_type || '').startsWith('audio/') ||\n             /\\.(mp3|m4a|aac|ogg|wav)$/i.test(m.document.file_name || '')))) {\n    const a = m.audio || m.document;\n    route = 'tg/audio';\n    Object.assign(body, { file_id: a.file_id, file_size: a.file_size || 0, file_name: a.file_name || '',\n                          mime_type: a.mime_type || '', title: a.title || '' });\n  } else if (m.photo || (m.document && (m.document.mime_type || '').startsWith('image/'))) {\n    const p = m.photo ? m.photo[m.photo.length - 1] : m.document;\n    route = 'tg/photo';\n    Object.assign(body, { file_id: p.file_id, file_size: p.file_size || 0, mime_type: p.mime_type || 'image/jpeg',\n                          caption: m.caption || '' });\n  } else if (m.document || m.voice || m.video_note || m.sticker) {\n    const f = m.document || m.voice || m.video_note || {};\n    route = 'tg/other';\n    Object.assign(body, { kind: m.document ? 'document' : m.voice ? 'voice' : m.video_note ? 'video_note' : 'sticker',\n                          file_name: f.file_name || '', mime_type: f.mime_type || '' });\n  } else if ((m.text || '').startsWith('/')) {\n    route = 'tg/command'; body.text = m.text;\n  } else if (m.text) {\n    route = 'tg/text'; body.text = m.text;\n  }\n}\nif (!route) return [];\nreturn [{ json: { route, body } }];"
      }
    },
    {
      "id": "1d08b453-1795-54f2-9065-e99eb4dfadf8",
      "name": "Báo đã nhận nút bấm",
